# Copy this file to .env.docker. Never commit the real .env.docker file.
MYSQL_ROOT_PASSWORD=replace_with_a_docker_mysql_password
POSTGRES_PASSWORD=replace_with_a_docker_postgres_password
JWT_SECRET_KEY=replace_with_a_long_random_secret
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_authorization_code
MAIL_FROM=your_email@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_FROM_NAME=AI Name
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
DASHSCOPE_IMAGE_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5173

ALIPAY_APP_ID=replace_with_your_alipay_app_id
ALIPAY_APP_PRIVATE_KEY=replace_with_your_alipay_private_key
ALIPAY_PUBLIC_KEY=replace_with_your_alipay_public_key
ALIPAY_DEBUG=true
ALIPAY_GATEWAY=replace_with_your_alipay_gateway
ALIPAY_RETURN_URL=http://127.0.0.1:8000/pay/success
ALIPAY_NOTIFY_URL=http://127.0.0.1:8000/pay/alipay_notify
